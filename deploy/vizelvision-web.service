[Unit]
Description=VizelVision master web app
After=network-online.target vizelvision-master.service
Wants=network-online.target
PartOf=vizelvision-stack.target

[Service]
Type=simple
WorkingDirectory=/home/vivian/vizelVision
ExecStart=/usr/bin/python3 -m roku_stream --config /home/vivian/vizelVision/config.master.json serve
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0077
