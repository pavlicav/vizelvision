[Unit]
Description=VizelVision Ads 5 (a channel of nothing but ads; page at /ads5/)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vivian/vizelVision
ExecStart=/usr/bin/python3 -m roku_stream.ads5 --port 6975
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
Nice=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
